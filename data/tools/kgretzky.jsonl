thub.com/kgretzky/evilginx2/releases/download/v3.3.0/evilginx-v3.3.0-windows-64bit.zip", "content_type": "application/x-zip-compressed", "created_at": "2024-04-02T13:33:50Z", "digest": null, "download_count": 12318, "id": 159886753, "label": null, "name": "evilginx-v3.3.0-windows-64bit.zip", "node_id": "RA_kwDOCF6HwM4Jh62h", "size": 8408381, "state": "uploaded", "updated_at": "2024-04-02T13:33:54Z", "uploader": {"avatar_url": "https://avatars.githubusercontent.com/u/19260967?v=4", "events_url": "https://api.github.com/users/kgretzky/events{/privacy}", "followers_url": "https://api.github.com/users/kgretzky/followers", "following_url": "https://api.github.com/users/kgretzky/following{/other_user}", "gists_url": "https://api.github.com/users/kgretzky/gists{/gist_id}", "gravatar_id": "", "html_url": "https://github.com/kgretzky", "id": 19260967, "login": "kgretzky", "node_id": "MDQ6VXNlcjE5MjYwOTY3", "organizations_url": "https://api.github.com/users/kgretzky/orgs", "received_events_url": "https://api.github.com/users/kgretzky/received_events", "repos_url": "https://api.github.com/users/kgretzky/repos", "site_admin": false, "starred_url": "https://api.github.com/users/kgretzky/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/kgretzky/subscriptions", "type": "User", "url": "https://api.github.com/users/kgretzky", "user_view_type": "public"}, "url": "https://api.github.com/repos/kgretzky/evilginx2/releases/assets/159886753"}], "assets_url": "https://api.github.com/repos/kgretzky/evilginx2/releases/149397518/assets", "author": {"avatar_url": "https://avatars.githubusercontent.com/u/19260967?v=4", "events_url": "https://api.github.com/users/kgretzky/events{/privacy}", "followers_url": "https://api.github.com/users/kgretzky/followers", "following_url": "https://api.github.com/users/kgretzky/following{/other_user}", "gists_url": "https://api.github.com/users/kgretzky/gists{/gist_id}", "gravatar_id": "", "html_url": "https://github.com/kgretzky", "id": 19260967, "login": "kgretzky", "node_id": "MDQ6VXNlcjE5MjYwOTY3", "organizations_url": "https://api.github.com/users/kgretzky/orgs", "received_events_url": "https://api.github.com/users/kgretzky/received_events", "repos_url": "https://api.github.com/users/kgretzky/repos", "site_admin": false, "starred_url": "https://api.github.com/users/kgretzky/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/kgretzky/subscriptions", "type": "User", "url": "https://api.github.com/users/kgretzky", "user_view_type": "public"}, "body": "### Go & Phish - Official Gophish integration released!\r\nYou can learn more about this update in the official blog post: https://breakdev.org/evilginx-3-3-go-phish/\r\n\r\n### CHANGELOG\r\n- Feature: Official GoPhish integration, using the fork: https://github.com/kgretzky/gophish\r\n- Feature: Added support to load custom TLS certificates from a public certificate file and a private key file stored in `~/.evilginx/crt/sites/<hostname>/`. Will load `fullchain.pem` and `privkey.pem` pair or a combination of a `.pem`/`.crt` (public certificate) and a `.key` (private key) file. Make sure to run without `-developer` flag and disable autocert retrieval with `config autocert off`.\r\n- Feature: Added ability to inject `force_post` POST parameters into JSON content body (by [@yudasm_](https://twitter.com/yudasm_)).\r\n- Feature: Added ability to disable automated TLS certificate retrieval from LetsEncrypt with `config autocert <on/off>`.\r\n- Feature: Evilginx will now properly recognize origin IP for requests coming from behind a reverse proxy (nginx/apache2/cloudflare/azure).\r\n- Fixed: Infinite redirection loop if the lure URL path was the same as the login path defined in the phishlet.\r\n- Fixed: Added support for exported cookies with names prefixed with `__Host-` and `__Secure-`.\r\n- Fixed: Global `unauth_url` can now be set to an empty string to have the server return `403` on unauthorized requests.\r\n- Fixed: Unauthorized redirects and blacklisting would be ignored for `proxy_hosts` with `session: false` (default) making it easy to detect evilginx by external scanners.\r\n- Fixed: IP address `127.0.0.1` is now ignored from being added to the IP blacklist.\r\n- Fixed: Added support for more TLDs to use with phishing domains (e.g. `xyz`, `art`, `tech`, `wiki`, `lol` & more)\r\n- Fixed: Credentials will now be captured also from intercepted requests.", "created_at": "2024-04-02T13:20:57Z", "draft": false, "html_url": "https://github.com/kgretzky/evilginx2/releases/tag/v3.3.0", "id": 149397518, "immutable": false, "name": "3.3.0 - Go & Phish", "node_id": "RE_kwDOCF6HwM4I56AO", "prerelease": false, "published_at": "2024-04-02T13:34:24Z", "reactions": {"+1": 25, "-1": 0, "confused": 0, "eyes": 9, "heart": 0, "hooray": 9, "laugh": 0, "rocket": 6, "total_count": 49, "url": "https://api.github.com/repos/kgretzky/evilginx2/releases/149397518/reactions"}, "tag_name": "v3.3.0", "tarball_url": "https://api.github.com/repos/kgretzky/evilginx2/tarball/v3.3.0", "target_commitish": "master", "updated_at": "2024-04-02T13:34:24Z", "upload_url": "https://uploads.github.com/repos/kgretzky/evilginx2/releases/149397518/assets{?name,label}", "url": "https://api.github.com/repos/kgretzky/evilginx2/releases/149397518", "zipball_url": "https://api.github.com/repos/kgretzky/evilginx2/zipball/v3.3.0"}, "name": "evilginx2", "owner": "kgretzky", "pushed_at": "2026-06-10T12:12:03Z", "sources": ["watchlist"], "stars": 15821, "tags": [], "topics": [], "url": "https://github.com/kgretzky/evilginx2"}
